{
  // micropod test harness wired into VS Code's task runner.
  // Tasks invoke the build/*.py scripts directly via python.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and test: all tags",
      "detail": "Docker images are kept.",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/build/build.py"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
    },
    {
      "label": "Build and test: pick tag",
      "detail": "Select a tag to run.",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/build/build.py",
        "--tag",
        "${input:tag}"
      ],
      "group": "test",
      "problemMatcher": [],
    },
    {
      "label": "Build: all tags",
      "detail": "Builds Docker images without testing.",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/build/build.py",
        "--without-test"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
    },
    {
      "label": "Export docker image to .tar.gz",
      "detail": "RouterOS-loadable, into build/out/. Build first.",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/build/export.py"
      ],
      "problemMatcher": [],
    },
    {
      "label": "Cleanup docker images",
      "detail": "Removes micropod:* images from Docker.",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/build/cleanup.py"
      ],
    }
  ],
  "inputs": [
    {
      "id": "tag",
      "type": "pickString",
      "description": "Which tag?",
      "options": [
        "alpine-arm64",
        "alpine-armv7",
        "debian-arm64",
        "debian-armv7",
        "debian-armv5"
      ],
      "default": "alpine-armv7"
    }
  ]
}